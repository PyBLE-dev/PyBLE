  "aboutPrivacyTitle": "Private by default",
  "@aboutPrivacyTitle": {
    "description": "About section heading for the frozen security and privacy posture."
  },
  "aboutPrivacyBody": "PyBLE requires no account and sends no telemetry by default. Your work stays on your tablet and connected board unless you explicitly export it. A user-started public GitHub import is the only optional network workflow.",
  "@aboutPrivacyBody": {
    "description": "Truthful offline-first privacy summary, including the sole optional network workflow."
