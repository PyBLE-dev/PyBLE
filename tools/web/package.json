{
  "name": "@pyble/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:static && npm run build:sites",
    "build:static": "node scripts/assert-no-local-firmware-preview.js && next build",
    "build:sites": "node scripts/assert-no-local-firmware-preview.js && vinext build && node scripts/prepare-sites-output.js",
    "firmware:stage": "node scripts/stage-firmware-release.js",
    "firmware:preview": "node scripts/stage-local-firmware-preview.js",
    "licenses:web": "node scripts/generate-website-third-party-licenses.js --check",
    "start": "vinext start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vinext:check": "vinext check",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run licenses:web && npm test && npm run vinext:check && npm run build"
  },
  "dependencies": {
    "@material/web": "2.2.0",
    "esp-web-tools": "10.4.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.32",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "29.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    }
  }
}
