                "psram": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["required", "size_bytes", "type"],
                  "properties": {
                    "required": {
                      "type": "boolean"
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "type": {
                      "enum": ["not-required", "octal"]
                    }
                  }
                }
              }
            },
            "flash": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "frequency_hz"],
              "properties": {
                "mode": {
                  "const": "dio"
                },
                "frequency_hz": {
                  "type": "integer",
                  "minimum": 1
