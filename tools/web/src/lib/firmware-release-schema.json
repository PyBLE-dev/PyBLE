              "const": "esp32-4mb"
            },
            "chip_family": {
              "const": "ESP32"
            },
            "silicon_revision": {
              "type": "object",
              "additionalProperties": false,
              "required": ["minimum_full", "maximum_full"],
              "properties": {
                "minimum_full": {
                  "type": "integer",
                  "minimum": 0
