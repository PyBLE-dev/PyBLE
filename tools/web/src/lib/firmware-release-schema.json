                },
                "size": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "components": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
